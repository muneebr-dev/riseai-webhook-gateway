{
  "name": "riseai-webhook-gateway",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev-server.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node24 --format=cjs --external:@aws-sdk/* --outfile=dist/index.js",
    "package": "pnpm build && cd dist && rm -f lambda.zip && zip -q lambda.zip index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "@types/node": "^24.19.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
